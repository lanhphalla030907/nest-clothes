# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is git-ignored;
# never commit real credentials.
# -----------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL=

# -----------------------------------------------------------------------------
# Cloudinary (https://cloudinary.com) — required.
#
# These three must all be present or the application refuses to start.
# Find them under Settings → API Keys in the Cloudinary console. The API secret
# grants full write access to the account: never log it, never return it in an
# API response, and never commit it.
# -----------------------------------------------------------------------------

# Your Cloudinary cloud name, e.g. demo
CLOUDINARY_CLOUD_NAME=

# Public API key, e.g. 123456789012345
CLOUDINARY_API_KEY=

# Private API secret — keep this one out of version control and logs
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# ABA PayWay Sandbox (https://checkout-sandbox.payway.com.kh) — optional.
#
# Unlike Cloudinary, these are NOT required to start the application. Payments is
# one provider behind one route, so the server boots and every other feature works
# without them — which is what lets CI and a fresh clone run the test suite at all.
#
# While any of the three is missing, `POST /orders/:orderId/payments` answers 503
# with a generic message and logs only the *names* of the missing variables. Nothing
# here is ever returned to a client or written to a log.
#
# The sandbox credentials come from the ABA PayWay sandbox dashboard. Use sandbox
# keys only: pointing this at live PayWay is out of scope for this project.
# -----------------------------------------------------------------------------

# Merchant id issued by the sandbox, e.g. lw00000000
PAYWAY_MERCHANT_ID=

# HMAC-SHA512 API key used to sign every request. Equivalent in power to a
# password: never log it, never return it, and never commit it.
PAYWAY_API_KEY=

# Absolute HTTPS URL PayWay posts payment results to. Must be reachable from
# PayWay's servers, so `localhost` will not work for a real callback.
# PayWay Base64-encodes and signs this value, so it is part of your merchant
# configuration — changing it changes what is signed.
PAYWAY_CALLBACK_URL=https://example.test/payments/aba-payway/callback

# Base URL for the PayWay API. Optional; when unset it defaults to
# `https://checkout-sandbox.payway.com.kh`. Set it only to point at a different
# PayWay environment — it must be `https`.
#
# Left *commented out* on purpose. An absent variable defaults to the sandbox, but an
# empty one is a value that fails validation — and a developer who copies this file
# without deleting the line would fill in the credentials above and still get 503,
# with the reason being a blank they cannot see.
# PAYWAY_BASE_URL=https://checkout-sandbox.payway.com/kh

# -----------------------------------------------------------------------------
# JWT access tokens — required.
#
# Unlike PayWay, the application cannot run without these: without a signing key no
# token can be issued or trusted, so the process refuses to start rather than serving
# requests it cannot authenticate.
#
# Generate the secret with `openssl rand -base64 48` (or any CSPRNG). The example below
# is a placeholder for local development only — it is public, in this repository, and
# must never be used anywhere a real account exists. At least 32 characters are
# required, because HS256's strength comes from the key length.
# -----------------------------------------------------------------------------

# HMAC signing key for access tokens. Never log it, never return it, never commit it.
JWT_ACCESS_SECRET=replace-with-a-random-48-byte-base64-string

# How long an access token stays valid: a number of seconds, or a `ms`/`s`/`m`/`h`/`d`
# suffix, e.g. `900`, `15m`, `1h`. Defaults to 15m when unset. Keep it short: there is
# no refresh token yet, so this is how long a revoked account keeps access.
JWT_ACCESS_EXPIRES_IN=15m

# `iss`/`aud` claims, verified on every request so a token minted for another service
# sharing the key is refused. Both default to the values below when unset.
JWT_ISSUER=clothes-ecommerce-api
JWT_AUDIENCE=clothes-ecommerce-clients
